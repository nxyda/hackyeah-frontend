<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- MAPA -->
    <com.mapbox.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:mapbox_locationComponentEnabled="true" />

    <!-- WYSZUKIWANIE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="6dp"
        android:background="@drawable/search_background"
        android:elevation="8dp">

        <EditText
            android:id="@+id/search_destination"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="Dokąd chcesz iść?"
            android:paddingStart="14dp"
            android:paddingEnd="8dp"
            android:singleLine="true"
            android:textSize="16sp" />

        <Button
            android:id="@+id/search_button"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Szukaj"
            android:textAllCaps="false"
            android:textSize="14sp" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/add_report_button"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="70dp"
        android:text="⚠"
        android:textSize="22sp"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        android:textAllCaps="false"
        android:elevation="8dp"
        app:cornerRadius="28dp"
        app:backgroundTint="#F44336" />

    <LinearLayout
        android:id="@+id/report_info_panel"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:padding="14dp"
        android:background="@drawable/report_info_background"
        android:elevation="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/report_info_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Zgłoszenie"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/report_info_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Kategoria:"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/report_info_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Godzina:"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/report_info_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="ID:"
            android:textSize="11sp" />

        <Button
            android:id="@+id/report_info_close"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:text="Zamknij"
            android:textAllCaps="false" />

    </LinearLayout>

    <!-- PRZYCISK MOJEJ LOKALIZACJI -->
    <ImageButton
        android:id="@+id/location_button"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="16dp"
        android:background="@drawable/map_button_background"
        android:contentDescription="Moja lokalizacja"
        android:elevation="8dp"
        android:padding="14dp"
        android:src="@android:drawable/ic_menu_mylocation" />

    <!-- WYBÓR RODZAJU TRASY -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="180dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/safe_route_button"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:text="🛡 Najbezpieczniejsza"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/fast_route_button"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:text="⚡ Najszybsza"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/balanced_route_button"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="⚖ Zbalansowana"
                android:textAllCaps="false" />

        </LinearLayout>

    </HorizontalScrollView>

    <!-- INFORMACJE O TRASIE -->
    <LinearLayout
        android:id="@+id/route_info_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp"
        android:background="@drawable/bottom_panel_background"
        android:elevation="12dp">

        <!-- TYTUŁ -->
        <TextView
            android:id="@+id/route_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Planowanie trasy"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- START -->
        <TextView
            android:id="@+id/start_point"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="📍 Start: moja lokalizacja"
            android:textSize="15sp" />

        <!-- CEL -->
        <TextView
            android:id="@+id/destination_point"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="🏁 Cel: nie wybrano"
            android:textSize="15sp" />

        <!-- INFORMACJA -->
        <TextView
            android:id="@+id/route_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Wybierz miejsce docelowe, aby wyznaczyć trasę."
            android:textSize="14sp" />

        <!-- BEZPIECZEŃSTWO -->
        <TextView
            android:id="@+id/safety_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="🛡 Poziom bezpieczeństwa: —"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>