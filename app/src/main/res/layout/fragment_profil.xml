<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="16dp"
    android:paddingTop="48dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- SEKCJA: STATUS I TRUST SCORE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E1E1E"
            android:orientation="horizontal"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="87" android:textColor="#4CAF50" android:textSize="48sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Trust Score" android:textColor="#AAAAAA" android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:orientation="vertical"
                android:gravity="center_vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Status konta:" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tv_phone_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚠️ Niezweryfikowany" android:textColor="#FFC107" android:layout_marginTop="8dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- SEKCJA: DANE UŻYTKOWNIKA -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DANE PROFILU"
            android:textColor="#888888"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/et_nickname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nick (np. @Ania)"
            android:textColorHint="#666666"
            android:textColor="#FFFFFF"
            android:backgroundTint="#444444"
            android:layout_marginBottom="12dp"/>

        <!-- Zmieniony, zablokowany numer telefonu z podpisem -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mój numer telefonu (Tylko do odczytu)"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:layout_marginBottom="2dp"/>

        <EditText
            android:id="@+id/et_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:focusable="false"
            android:textColor="#888888"
            android:backgroundTint="#333333"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btn_verify_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Zweryfikuj numer"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="24dp"/>

        <!-- SEKCJA: KONTAKTY SOS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KONTAKTY SOS (Max 5)"
            android:textColor="#888888"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <!-- Dynamiczne wiersze SOS -->
        <LinearLayout android:id="@+id/row_sos_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp" android:visibility="gone">
            <EditText android:id="@+id/et_sos_contact_1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="Numer SOS (+48...)" android:inputType="phone" android:textColor="#FFFFFF" android:textColorHint="#666666" android:backgroundTint="#444444" />
            <Button android:id="@+id/btn_del_sos_1" android:layout_width="48dp" android:layout_height="match_parent" android:text="X" android:textColor="#FFFFFF" android:backgroundTint="#AA0000" android:layout_marginStart="8dp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/row_sos_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp" android:visibility="gone">
            <EditText android:id="@+id/et_sos_contact_2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="Numer SOS (+48...)" android:inputType="phone" android:textColor="#FFFFFF" android:textColorHint="#666666" android:backgroundTint="#444444" />
            <Button android:id="@+id/btn_del_sos_2" android:layout_width="48dp" android:layout_height="match_parent" android:text="X" android:textColor="#FFFFFF" android:backgroundTint="#AA0000" android:layout_marginStart="8dp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/row_sos_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp" android:visibility="gone">
            <EditText android:id="@+id/et_sos_contact_3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="Numer SOS (+48...)" android:inputType="phone" android:textColor="#FFFFFF" android:textColorHint="#666666" android:backgroundTint="#444444" />
            <Button android:id="@+id/btn_del_sos_3" android:layout_width="48dp" android:layout_height="match_parent" android:text="X" android:textColor="#FFFFFF" android:backgroundTint="#AA0000" android:layout_marginStart="8dp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/row_sos_4" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp" android:visibility="gone">
            <EditText android:id="@+id/et_sos_contact_4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="Numer SOS (+48...)" android:inputType="phone" android:textColor="#FFFFFF" android:textColorHint="#666666" android:backgroundTint="#444444" />
            <Button android:id="@+id/btn_del_sos_4" android:layout_width="48dp" android:layout_height="match_parent" android:text="X" android:textColor="#FFFFFF" android:backgroundTint="#AA0000" android:layout_marginStart="8dp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/row_sos_5" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp" android:visibility="gone">
            <EditText android:id="@+id/et_sos_contact_5" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="Numer SOS (+48...)" android:inputType="phone" android:textColor="#FFFFFF" android:textColorHint="#666666" android:backgroundTint="#444444" />
            <Button android:id="@+id/btn_del_sos_5" android:layout_width="48dp" android:layout_height="match_parent" android:text="X" android:textColor="#FFFFFF" android:backgroundTint="#AA0000" android:layout_marginStart="8dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_add_sos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="+ Dodaj kolejny numer"
            android:backgroundTint="#222222"
            android:textColor="#4CAF50"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Treść wiadomości ratunkowej SMS:"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/et_sos_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Wpisz treść (max 100 znaków)"
            android:maxLength="100"
            android:textColorHint="#666666"
            android:textColor="#FFFFFF"
            android:backgroundTint="#444444"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btn_save_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Zapisz cały profil i ustawienia"
            android:backgroundTint="#AA0000"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="32dp"/>

        <!-- SEKCJA: MOJE ZGŁOSZENIA -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MOJE ZGŁOSZENIA"
            android:textColor="#888888"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#1E1E1E" android:orientation="vertical" android:padding="12dp" android:layout_marginBottom="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Zagrożenie: Brak oświetlenia" android:textColor="#FFFFFF" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📍 ul. Floriańska (Wczoraj, 21:30)" android:textColor="#AAAAAA" android:textSize="12sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Status: ✅ Potwierdzone przez 5 osób" android:textColor="#4CAF50" android:textSize="12sp" android:layout_marginTop="4dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#1E1E1E" android:orientation="vertical" android:padding="12dp" android:layout_marginBottom="32dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Zagrożenie: Podejrzana grupa" android:textColor="#FFFFFF" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📍 Park Krakowski (Dzisiaj, 18:15)" android:textColor="#AAAAAA" android:textSize="12sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Status: ⏳ Oczekuje na weryfikację" android:textColor="#FFC107" android:textSize="12sp" android:layout_marginTop="4dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>